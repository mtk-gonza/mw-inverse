[sub_resource type="Shader" id="Shader_water"]
code = "shader_type spatial;\nrender_mode diffuse_burley, cull_back;\n\nvoid fragment() {\n    vec2 uv = UV * 8.0;\n    float wave = sin(uv.x * 2.0 + TIME * 0.45) * 0.5 + sin(uv.y * 3.0 - TIME * 0.3) * 0.5;\n    vec3 deep = vec3(0.08, 0.25, 0.62);\n    vec3 light = vec3(0.35, 0.66, 0.98);\n    ALBEDO = mix(deep, light, wave * 0.35 + 0.5);\n    ROUGHNESS = 0.2;\n    METALLIC = 0.05;\n}\n"

